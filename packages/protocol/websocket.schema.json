{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-pi.local/protocol/v2/websocket.schema.json",
  "title": "Remote Pi WebSocket v2",
  "description": "Nothing is replayed. subscribe_all gives every Agent's state, then overview events of every Agent. focus selects the one Agent whose details (streamed text, timeline items, tool output) this socket receives. The timeline itself is read over HTTP: GET /api/v1/agents/{id}/timeline and GET /api/v1/agents/{id}/sessions/{sessionId}/items/{itemId}.",
  "oneOf": [
    {"$ref":"#/$defs/subscribeAll"}, {"$ref":"#/$defs/subscribedAll"}, {"$ref":"#/$defs/focus"}, {"$ref":"#/$defs/watch"},
    {"$ref":"#/$defs/command"}, {"$ref":"#/$defs/commandResult"}, {"$ref":"#/$defs/agentEvent"}, {"$ref":"#/$defs/agentStateUpdate"},
    {"$ref":"#/$defs/focusState"}, {"$ref":"#/$defs/delta"}, {"$ref":"#/$defs/items"}, {"$ref":"#/$defs/timelineReset"}, {"$ref":"#/$defs/toolOutput"},
    {"$ref":"#/$defs/subscribeDrafts"}, {"$ref":"#/$defs/subscribedDrafts"}, {"$ref":"#/$defs/draftAck"}, {"$ref":"#/$defs/draftEvent"}
  ],
  "$defs": {
    "subscribeDrafts": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"subscribe_drafts"}},"description":"Full pairing code only: receive pending drafts from voice clients."},
    "subscribedDrafts": {"type":"object","required":["type","protocolVersion"],"properties":{"type":{"const":"subscribed_drafts"},"protocolVersion":{"const":1}}},
    "draftAck": {"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"const":"draft_ack"},"id":{"type":"string"}}},
    "draftEvent": {"type":"object","required":["type","draft"],"properties":{"type":{"const":"draft_event"},"replay":{"type":"boolean"},"draft":{"type":"object","required":["id","text","mode","createdAt"],"properties":{"id":{"type":"string"},"text":{"type":"string"},"mode":{"enum":["append","replace"]},"source":{"type":"string"},"createdAt":{"type":"string"}}}}},
    "subscribeAll": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"subscribe_all"}},"description":"Receive agent_state for every Agent, then overview agent_event messages of every Agent."},
    "subscribedAll": {"type":"object","required":["type","protocolVersion","serverTime"],"properties":{"type":{"const":"subscribed_all"},"protocolVersion":{"const":2},"serverTime":{"type":"integer","description":"Server epoch milliseconds, to correct clock skew for activity times."}}},
    "focus": {"type":"object","additionalProperties":false,"required":["type","agentId"],"properties":{"type":{"const":"focus"},"agentId":{"type":["string","null"]}},"description":"View one Agent in detail (null: none). Replies with focus_state; replaces the previous focus and its watches."},
    "watch": {"type":"object","additionalProperties":false,"required":["type","toolCallId"],"properties":{"type":{"enum":["watch","unwatch"]},"toolCallId":{"type":"string"}},"description":"Start or stop tool_output for a running tool of the focused Agent, e.g. while its card is expanded."},
    "command": {"type":"object","additionalProperties":false,"required":["type","requestId","agentId"],"properties":{"type":{"enum":["prompt","steer","follow-up","abort","clear-queue"]},"requestId":{"type":"string"},"agentId":{"type":"string"},"message":{"type":"string","maxLength":2097152}}},
    "commandResult": {"type":"object","required":["type","success"],"properties":{"type":{"const":"command_result"},"requestId":{"type":"string"},"success":{"type":"boolean"},"error":{"type":"object"},"disposition":{"enum":["handled","queued"],"description":"For steer and follow-up: whether the running turn took the message or it waits in the queue."},"queue":{"$ref":"#/$defs/queue"}}},
    "queue": {"type":"object","required":["steering","followUp"],"description":"Messages waiting for the running turn.","properties":{"steering":{"type":"array","items":{"type":"string"}},"followUp":{"type":"array","items":{"type":"string"}}}},
    "agentEvent": {"type":"object","required":["type","agentId","timestamp","status","event"],"properties":{"type":{"const":"agent_event"},"agentId":{"type":"string"},"timestamp":{"type":"integer","minimum":0,"description":"Epoch milliseconds."},"status":{"$ref":"#/$defs/agentStatus","description":"Agent status after this event."},"event":{"type":"object","required":["type"],"description":"Overview events of every Agent: agent_start, agent_end {willRetry, aborted}, agent_settled, activity_changed {activity}, queue_update, session_info_changed, agent_unloaded, auto_retry_*, summarization_retry_*, extension_ui_*. For the focused Agent also bash_execution_start/update/end (output of user shell commands)."}}},
    "focusState": {"type":"object","required":["type","agentId","live"],"properties":{"type":{"const":"focus_state"},"agentId":{"type":"string"},"sessionId":{"type":"string"},"live":{"oneOf":[{"type":"null"},{"type":"object","required":["text","thinking"],"properties":{"text":{"type":"string"},"thinking":{"type":"string"}}}],"description":"Text streamed so far for the message being generated."},"dialogRequests":{"type":"array","description":"Pending dialogs, to rebuild their controls in the transcript."}}},
    "delta": {"type":"object","required":["type","agentId","kind","delta"],"properties":{"type":{"const":"delta"},"agentId":{"type":"string"},"kind":{"enum":["text","thinking"]},"delta":{"type":"string"}},"description":"More streamed text; adjacent tokens are coalesced."},
    "items": {"type":"object","required":["type","agentId","sessionId","items"],"properties":{"type":{"const":"items"},"agentId":{"type":"string"},"sessionId":{"type":"string"},"items":{"type":"array","items":{"$ref":"#/$defs/timelineItem"}},"clearLive":{"const":true,"description":"The streamed message was recorded: drop its streamed text."}},"description":"Items appended to the timeline, and items whose status changed (a running tool finished)."},
    "timelineReset": {"type":"object","required":["type","agentId","sessionId"],"properties":{"type":{"const":"timeline_reset"},"agentId":{"type":"string"},"sessionId":{"type":"string"}},"description":"The branch changed other than by appending: reload the timeline."},
    "toolOutput": {"type":"object","required":["type","agentId","toolCallId","output"],"properties":{"type":{"const":"tool_output"},"agentId":{"type":"string"},"toolCallId":{"type":"string"},"output":{"type":"string","description":"Latest output so far, replacing earlier ones."}}},
    "timelineItem": {
      "type":"object","required":["id","kind","size"],
      "description":"One displayable part of a recorded session entry. Ids derive from entry ids, so items never change except a pending tool's status. Bodies of user, assistant and error items, and other bodies up to 256 characters, are inline; others load from the item endpoint, which completed items let clients cache forever.",
      "properties":{
        "id":{"type":"string"},
        "kind":{"enum":["user","assistant","thinking","error","tool","bash","compaction","branch_summary","custom","system"]},
        "timestamp":{"type":"integer"},
        "title":{"type":"string"},
        "summary":{"type":"string"},
        "status":{"enum":["pending","ok","error","cancelled"]},
        "durationMs":{"type":"number"},
        "toolCallId":{"type":"string","description":"Running tools only: the id to watch their output."},
        "size":{"type":"integer","minimum":0},
        "body":{"type":"string"}
      }
    },
    "agentStatus": {"enum":["unloaded","starting","idle","streaming","waiting_for_user","error","stopping","stopped"]},
    "agentStateUpdate": {"type":"object","required":["type","agentId","state"],"description":"Current state of one Agent, sent for every Agent on subscribe_all.","properties":{"type":{"const":"agent_state"},"agentId":{"type":"string"},"state":{"$ref":"#/$defs/agentState"}}},
    "activity": {
      "type":"object","required":["run","phase","bash","dialogs"],
      "description":"What the Agent is doing now, maintained by the server. Also pushed as agent event {type:'activity_changed', activity} on every change. Times are server epoch milliseconds; correct skew with subscribed_all.serverTime.",
      "properties":{
        "run":{"oneOf":[{"type":"null"},{"type":"object","required":["startedAt"],"properties":{"startedAt":{"type":"integer"}}}]},
        "phase":{
          "type":"object","required":["kind","since"],
          "properties":{
            "kind":{"enum":["idle","waiting_llm","thinking","generating","preparing_tool","running_tools","retrying","compacting","stopping"]},
            "since":{"type":"integer"},
            "toolName":{"type":"string","description":"preparing_tool"},
            "tools":{"type":"array","description":"running_tools: top-level tools in parallel","items":{"type":"object","required":["toolCallId","toolName","since"],"properties":{"toolCallId":{"type":"string"},"toolName":{"type":"string"},"summary":{"type":"string","description":"Command, path or pattern, at most 80 characters"},"since":{"type":"integer"}}}},
            "attempt":{"type":"integer"},"maxAttempts":{"type":"integer"},"retryAt":{"type":"integer"},"error":{"type":"string"},
            "reason":{"type":"string","description":"compacting"}
          }
        },
        "bash":{"type":"array","items":{"type":"object","required":["id","since"],"properties":{"id":{"type":"string"},"command":{"type":"string"},"since":{"type":"integer"}}}},
        "dialogs":{"type":"array","items":{"type":"object","required":["requestId","since"],"properties":{"requestId":{"type":"string"},"title":{"type":"string"},"since":{"type":"integer"}}}}
      }
    },
    "agentState": {
      "type":"object","required":["status","agentId","sessionId","cwd"],
      "properties":{
        "status":{"$ref":"#/$defs/agentStatus"},
        "agentId":{"type":"string"},
        "sessionId":{"type":"string"},
        "sessionFile":{"type":"string"},
        "sessionName":{"type":"string"},
        "cwd":{"type":"string"},
        "activity":{
          "description":"Live activity plus dialog payloads and queue. Never persisted.",
          "allOf":[{"$ref":"#/$defs/activity"}],
          "properties":{
            "dialogRequests":{
              "type":"array","description":"Pending request payloads for rebuilding dialog controls, without submitted answers.",
              "items":{
                "type":"object","required":["type","requestId","kind"],
                "properties":{
                  "type":{"const":"extension_ui_request"},"requestId":{"type":"string"},
                  "kind":{"enum":["select","confirm","input","editor"]},
                  "title":{"type":"string"},"message":{"type":"string"},
                  "options":{"type":"array","items":{"type":"string"}},
                  "placeholder":{"type":"string"},"prefill":{"type":"string"},"opts":{"type":"object"}
                }
              }
            },
            "queue":{"$ref":"#/$defs/queue"}
          }
        }
      }
    }
  }
}
