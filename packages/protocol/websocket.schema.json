{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-pi.local/protocol/v1/websocket.schema.json",
  "title": "Remote Pi WebSocket v1",
  "oneOf": [
    {"$ref":"#/$defs/subscribe"}, {"$ref":"#/$defs/command"}, {"$ref":"#/$defs/subscribed"},
    {"$ref":"#/$defs/commandResult"}, {"$ref":"#/$defs/agentEvent"}, {"$ref":"#/$defs/agentSnapshot"}, {"$ref":"#/$defs/agentStateUpdate"},
    {"$ref":"#/$defs/subscribeAttention"}, {"$ref":"#/$defs/subscribedAttention"}, {"$ref":"#/$defs/attentionEvent"},
    {"$ref":"#/$defs/subscribeDrafts"}, {"$ref":"#/$defs/subscribedDrafts"}, {"$ref":"#/$defs/draftAck"}, {"$ref":"#/$defs/draftEvent"}
  ],
  "$defs": {
    "subscribeDrafts": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"subscribe_drafts"}},"description":"Full pairing code only: receive pending drafts from voice clients."},
    "subscribedDrafts": {"type":"object","required":["type","protocolVersion"],"properties":{"type":{"const":"subscribed_drafts"},"protocolVersion":{"const":1}}},
    "draftAck": {"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"const":"draft_ack"},"id":{"type":"string"}}},
    "draftEvent": {"type":"object","required":["type","draft"],"properties":{"type":{"const":"draft_event"},"replay":{"type":"boolean"},"draft":{"type":"object","required":["id","text","mode","createdAt"],"properties":{"id":{"type":"string"},"text":{"type":"string"},"mode":{"enum":["append","replace"]},"agentId":{"type":"string"},"source":{"type":"string"},"createdAt":{"type":"string"}}}}},
    "subscribeAttention": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"subscribe_attention"},"sinceSeq":{"type":"integer","minimum":0},"pendingOnly":{"type":"boolean"}},"description":"Voice/notification clients: replay attention items newer than sinceSeq, then stream new and updated ones."},
    "subscribedAttention": {"type":"object","required":["type","protocolVersion","lastSeq"],"properties":{"type":{"const":"subscribed_attention"},"protocolVersion":{"const":1},"lastSeq":{"type":"integer","minimum":0}}},
    "attentionEvent": {"type":"object","required":["type","change","item"],"properties":{"type":{"const":"attention_event"},"change":{"enum":["new","updated"]},"replay":{"type":"boolean"},"item":{"$ref":"#/$defs/attentionItem"}}},
    "attentionItem": {"type":"object","required":["id","seq","kind","priority","requiresResponse","createdAt","data"],"properties":{"id":{"type":"string"},"seq":{"type":"integer","minimum":1},"kind":{"enum":["agent_settled","needs_input","collab_escalation"]},"priority":{"enum":["low","normal","high"]},"requiresResponse":{"type":"boolean"},"agentId":{"type":"string"},"sessionName":{"type":"string"},"createdAt":{"type":"string"},"resolvedAt":{"type":"string"},"ackedAt":{"type":"string"},"ackedBy":{"type":"string"},"data":{"type":"object"}}},
    "subscribe": {"type":"object","additionalProperties":false,"required":["type","agentId"],"properties":{"type":{"const":"subscribe"},"agentId":{"type":"string"},"lastSequence":{"type":"integer","minimum":0},"fromNow":{"type":"boolean"},"messageLimit":{"type":"integer","minimum":1,"maximum":200}}},
    "command": {"type":"object","additionalProperties":false,"required":["type","requestId","agentId"],"properties":{"type":{"enum":["prompt","steer","follow-up","abort","clear-queue"]},"requestId":{"type":"string"},"agentId":{"type":"string"},"message":{"type":"string","maxLength":2097152}}},
    "subscribed": {"type":"object","required":["type","agentId","protocolVersion"],"properties":{"type":{"const":"subscribed"},"agentId":{"type":"string"},"protocolVersion":{"const":1},"currentSequence":{"type":"integer","minimum":0}}},
    "commandResult": {"type":"object","required":["type","success"],"properties":{"type":{"const":"command_result"},"requestId":{"type":"string"},"success":{"type":"boolean"},"error":{"type":"object"},"disposition":{"enum":["handled","queued"],"description":"For steer and follow-up: whether the running turn took the message or it waits in the queue. Omitted by older servers."},"queue":{"$ref":"#/$defs/queue"}}},
    "queue": {"type":"object","required":["steering","followUp"],"description":"Messages waiting for the running turn.","properties":{"steering":{"type":"array","items":{"type":"string"}},"followUp":{"type":"array","items":{"type":"string"}}}},
    "agentEvent": {"type":"object","required":["type","agentId","eventId","sequence","event"],"properties":{"type":{"const":"agent_event"},"agentId":{"type":"string"},"eventId":{"type":"string"},"sequence":{"type":"integer","minimum":1},"timestamp":{"type":"integer","minimum":0},"status":{"$ref":"#/$defs/agentStatus","description":"Agent status after this event. Omitted by older servers."},"event":{"type":"object","required":["type"]}}},
    "agentStatus": {"enum":["unloaded","starting","idle","streaming","waiting_for_user","error","stopping","stopped"]},
    "agentSnapshot": {"type":"object","required":["type","agentId","lastSequence","state","messages"],"properties":{"type":{"const":"agent_snapshot"},"agentId":{"type":"string"},"lastSequence":{"type":"integer","minimum":0},"state":{"$ref":"#/$defs/agentState"},"messages":{"type":"array"}}},
    "agentStateUpdate": {"type":"object","required":["type","agentId","sequence","state"],"description":"Current state after initial replay/snapshot and before live events, also sent for fromNow or empty replay. Does not replace transcript messages.","properties":{"type":{"const":"agent_state"},"agentId":{"type":"string"},"sequence":{"type":"integer","minimum":0},"state":{"$ref":"#/$defs/agentState"}}},
    "agentState": {
      "type":"object","required":["status","agentId","sessionId","cwd"],
      "properties":{
        "status":{"$ref":"#/$defs/agentStatus"},
        "agentId":{"type":"string"},
        "sessionId":{"type":"string"},
        "sessionFile":{"type":"string"},
        "sessionName":{"type":"string"},
        "cwd":{"type":"string"},
        "activity":{
          "type":"object","required":["bashIds","dialogIds"],
          "description":"Runtime operations independent of LLM status. Omitted by older servers; never persisted.",
          "properties":{
            "bashIds":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
            "dialogIds":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
            "dialogRequests":{
              "type":"array","description":"Pending request payloads for rebuilding dialog controls, without submitted answers. Omitted by older servers.",
              "items":{
                "type":"object","required":["type","requestId","kind"],
                "properties":{
                  "type":{"const":"extension_ui_request"},"requestId":{"type":"string"},
                  "kind":{"enum":["select","confirm","input","editor"]},
                  "title":{"type":"string"},"message":{"type":"string"},
                  "options":{"type":"array","items":{"type":"string"}},
                  "placeholder":{"type":"string"},"prefill":{"type":"string"},"opts":{"type":"object"}
                }
              }
            },
            "queue":{"$ref":"#/$defs/queue"}
          }
        }
      }
    }
  }
}
